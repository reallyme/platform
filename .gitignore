# Cargo credentials are machine-local and may grant registry publish access.
**/.cargo/credentials
**/.cargo/credentials.toml

# Local environment and secret material. Keep documented templates trackable.
.env
.env.*
**/.env
**/.env.*
!/.env.example
!/.env.sample
!/.env.template
!**/.env.example
!**/.env.sample
!**/.env.template
**/*.local.env
**/*.secret
**/*.secret.*
**/*.secrets
**/*.secrets.*
.secrets/
**/.secrets/
**/secrets/*
!**/secrets/.gitignore
!**/secrets/*.example
!**/secrets/*.sample
!**/secrets/*.template

# Private keys and local credential stores. Public trust-anchor certificates
# remain trackable by design.
**/*-private-key.pem
**/*-signing-key.pem
**/id_rsa
**/id_ed25519
**/*.p12
**/*.pfx
**/*.jks
**/*.keystore
**/*service-account*.json
**/*service_account*.json
**/*credentials*.json

# Local persistence, logs, and infrastructure state can contain PII or secrets.
**/*.sqlite
**/*.sqlite3
**/*.db
**/*.redb
**/*.log
**/*.tfstate
**/*.tfstate.*
**/*.tfvars
**/.terraform/
proptest-regressions/
/AGENTS.md
/ENGINEERING_STANDARDS.md
/workers/*/build
**/.wrangler/
**/node_modules/

# Claude review ignore rules are defined in .claudeignore

# Keep generated Rust/build artifacts out of git tooling and local commits.
# The two checked-in contract crates below are an intentional exception: their
# generated API surface is reviewed together with the schema and distributed
# wherever the contract crate is packaged.
