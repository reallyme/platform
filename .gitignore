/target
target/
**/target/
**/*.rs.bk
**/*.pdb
**/*.dSYM/
**/*.profdata
**/*.gcov
**/*.crate
.DS_Store
**/.DS_Store
.wrangler/

# Cargo credentials are machine-local and may grant registry publish access.
**/.cargo/credentials
**/.cargo/credentials.toml

# Local environment and secret material. Keep documented templates trackable.
.env
.env.*
**/.env
**/.env.*
**/.dev.vars
**/.dev.vars.*
!/.env.example
!/.env.sample
!/.env.template
!**/.env.example
!**/.env.sample
!**/.env.template
!**/.dev.vars.example
!**/.dev.vars.sample
!**/.dev.vars.template
**/*.local.env
**/*.secret
**/*.secret.*
**/*.secrets
**/*.secrets.*
.secrets/
**/.secrets/
**/secrets/*
!**/secrets/.gitignore
!**/secrets/*.example
!**/secrets/*.sample
!**/secrets/*.template

# Private keys and local credential stores. Public trust-anchor certificates
# remain trackable by design.
**/*-private-key.pem
**/*-signing-key.pem
**/id_rsa
**/id_ed25519
**/*.key
**/*.p12
**/*.pfx
**/*.jks
**/*.keystore
**/*.mobileprovision
**/*service-account*.json
**/*service_account*.json
**/*credentials*.json
**/.netrc
**/.npmrc
**/.pypirc
**/.aws/
**/.config/gcloud/
**/.kube/config
**/.docker/config.json

# Local persistence, logs, and infrastructure state can contain PII or secrets.
**/*.sqlite
**/*.sqlite3
**/*.db
**/*.redb
**/*.log
**/*.tfstate
**/*.tfstate.*
**/*.tfvars
**/*.tfplan
**/.terraform/
proptest-regressions/
**/AGENTS.md
**/ENGINEERING_STANDARDS.md
/release-attestation/
/workers/*/build
/.pnpm-store/
**/.wrangler/
**/node_modules/
**/.direnv/
**/.envrc

# Keep generated Rust/build artifacts out of git tooling and local commits.
# The checked-in example contract is an intentional exception: its generated
# API surface is reviewed together with the schema and distributed with the crate.
**/generated
**/generated/**
**/src/generated
**/src/generated/**
!apps/example/contract/src/generated/
!apps/example/contract/src/generated/**
**/src/pb
**/src/pb/**
**/src/prost
**/src/prost/**
**/*_grpc.rs
**/*.grpc.rs
**/*_pb.rs
**/*.pb.rs
**/*_tonic.rs
**/*.tonic.rs
**/*_prost.rs
**/*.prost.rs
**/*_generated.rs
**/*.generated.rs
**/*.gen.rs
**/*.protos.rs
**/*.capnp.rs
*.rmeta
*.rlib
*.prof*
*.gcda
*.gcno
*.profraw
*.d
